# ============================================================================
# Personal Automation Platform — environment configuration
#
# Copy to `.env` (dev) or install as /etc/pap/pap.env (prod, mode 0600) and load
# it with compose's `env_file:`. Never commit the real file — it holds secrets.
#
# Claude Code cannot read `.env` (denied in .claude/settings.json). This example
# is the only version it works from, so keep it complete and current.
#
# Check what is set without printing any value:  pap doctor
#
# This file is read by python-dotenv, NOT by a shell. Do not `source` it:
# unquoted values with spaces or parentheses are a shell syntax error, and if the
# file has Windows (CRLF) line endings the shell appends a carriage return to
# every value while python-dotenv strips it — so the two disagree by one
# invisible character and authentication fails with no visible cause.
# Editing on Windows? Keep LF endings, or run:  sed -i 's/\r$//' .env
# ============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# PG_HOST depends on WHERE the command runs, and getting it wrong is the most
# common first-run failure:
#   inside compose ............ postgres        (the service name)
#   local WSL testing ......... 127.0.0.1  with PG_PORT=55432
#   your workstation -> server. <TAILSCALE_IP>   (Tailscale)
# The service name resolves ONLY inside the Docker network.
PG_HOST=postgres
PG_PORT=5432
PG_DB=pap
PG_USER=pap
PG_PASSWORD=change_me

# --- Runtime ------------------------------------------------------------------
# These are CONTAINER paths, because that is where this file is normally loaded.
# /var/lib/pap is the mounted volume; /app is read-only to the `pap` user, so a
# relative path like ./logs silently fails to open there.
# Running on the host instead? Override to ./var/logs, ./var/secrets, ./var/backups.
LOG_DIR=/var/lib/pap/logs
LOG_LEVEL=INFO
# Where tokens and cooldown markers live (mode 0600). Must be on a filesystem that
# honours chmod — a Docker volume on ext4, never a Windows mount (WSL's /mnt/c
# ignores chmod, leaving credentials world-readable; `pap doctor` probes for this).
PAP_STATE_DIR=/var/lib/pap/secrets
# Every outbound HTTP request waits this long after the previous one (per session).
HTTP_REQUEST_DELAY_SECONDS=0.5
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT="personal-automation-platform/0.1 (+personal use)"
RETRY_MAX_ATTEMPTS=4
RETRY_BACKOFF_SECONDS=2

# --- Telegram (primary notification channel) ----------------------------------
# Create a bot with @BotFather; get the chat id by messaging the bot and reading
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHAT_ID=change_me

# --- Email / SMTP (secondary channel) -----------------------------------------
# For Gmail use an App Password, not your account password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=change_me
SMTP_PASSWORD=change_me
EMAIL_FROM=change_me
EMAIL_TO=change_me

# --- Observability: GlitchTip (Sentry-compatible error tracking) ---------------
# Leave SENTRY_DSN empty to disable error reporting entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Stamped into every event so GlitchTip can say "first seen in this release".
# The Docker build passes the image tag / git sha in as PAP_RELEASE.
PAP_RELEASE=dev

# --- Observability: Healthchecks (did the job run at all?) --------------------
# Slug-based pinging: <base>/ping/<ping-key>/<slug>. Jobs use the slug `pap-<job>`
# and are auto-created on first ping. Leave the key empty to disable.
HEALTHCHECKS_BASE_URL=http://healthchecks:8000
HEALTHCHECKS_PING_KEY=
HEALTHCHECKS_SLUG_PREFIX=pap

# --- Google (Drive + Calendar) ------------------------------------------------
# Credentials live HERE — no token file needs to be copied to the server.
#
# To fill these in, on a machine WITH A BROWSER (your WSL/desktop):
#   1. Google Cloud Console -> create an OAuth *Desktop* client
#   2. Copy its Client ID + Client secret into the two variables below
#   3. pap auth --login --no-browser --port 8765
#   4. Paste the GOOGLE_REFRESH_TOKEN it prints, and set GOOGLE_ENABLED=true
# No JSON download is needed — the flow is built from the two values below.
#
# The refresh token is a password: it grants access until revoked at
# https://myaccount.google.com/permissions
#
# Scopes are deliberately minimal — drive.file can only see files this app itself
# created, never the rest of your Drive.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Optional alternative to the two variables above, if you'd rather use the
# downloaded JSON. Only ever needed on the machine running `pap auth --login`.
GOOGLE_CLIENT_SECRETS_FILE=

# Legacy alternative to the three variables above. Leave empty when using them.
# GOOGLE_TOKEN_FILE=/var/lib/pap/secrets/google_token.json

GOOGLE_DRIVE_ROOT_FOLDER=Studeo
GOOGLE_DRIVE_BACKUP_FOLDER=_backups/pap
GOOGLE_CALENDAR_ID=primary

# --- Backups ------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DIR=/var/lib/pap/backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# --- Book resumes (Phase 4; defaults, overridable per book in book.config) -----
RESUME_CADENCE=daily
RESUME_SEND_AT=07:00
RESUME_UNIT=chapter
RESUME_TARGET_WORDS=600
RESUME_STYLE=study-notes
RESUME_LANG=pt-BR

# --- LLM providers (Phase 2; keys only, no calls are made until then) ---------
LLM_PROVIDER_DEFAULT=claude
# LLM_PROVIDER_DELIVERABLE=claude
# LLM_PROVIDER_BOOK_RESUME=gemini
# LLM_PROVIDER_CLASSIFY=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Studeo (Phase 1; shape confirmed by docs/studeo-api.md discovery) --------
STUDEO_ENABLED=false
STUDEO_BASE_URL=https://studeo.unicesumar.edu.br
STUDEO_USERNAME=
STUDEO_PASSWORD=
